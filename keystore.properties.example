# Copy to keystore.properties (git-ignored) to build a publishable release.
#
# Create the upload key once, and keep the .jks and these passwords somewhere
# you will still have in two years — losing them means losing the ability to
# update the app under this package name:
#
#   keytool -genkey -v -keystore tend-upload.jks -alias tend \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repository root.

storeFile=tend-upload.jks
storePassword=CHANGE_ME
keyAlias=tend
keyPassword=CHANGE_ME
